#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {

        conditional_layers {
            compatible = "zmk,conditional-layers";

            adjust {
                if-layers = <1 2>;
                then-layer = <3>;
            };
        };

        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  Q  |  W  |  E   |  R  |  T  |   |  Y  |  U  |  I   |  O  |  P  | ESC  |
// |  CTL |  A  |  S  |  D   |  F  |  G  |   |  H  |  J  |  K   |  L  |  ;  |  '   |
// |  ALT |  Z  |  X  |  C   |  V  |  B  |   |  N  |  M  |  ,   |  .  |  /  | GUI  |
//                    | SHFT | ENT | LWR |   | RSE | SPC | BKSP |
                        bindings = <
    &kp TAB     &kp Q       &kp W      &kp E      &kp R    &kp T       &kp Y       &kp U       &kp I       &kp O       &kp P       &kp ESC
    &kp LCTRL   &kp A       &kp S      &kp D      &kp F    &kp G       &kp H       &kp J       &kp K       &kp L       &kp SEMI    &kp SQT
    &kp LALT    &kp Z       &kp X      &kp C      &kp V    &kp B       &kp N       &kp M       &kp COMMA   &kp DOT     &kp FSLH    &kp LGUI
                                       &kp LSHFT  &kp RET  &mo 1       &mo 2       &kp SPACE   &kp BSPC
                                        >;
                };

                lower_layer {
// -----------------------------------------------------------------------------------------
// | TAB |  !  |  @  |  #   |  $  |  %  |   |  ^  |  &  |  *   |  (  |  )  |  `  |
// | CTL |  1  |  2  |  3   |  4  |  5  |   |  6  |  7  |  8   |  9  |  0  |  ~  |
// | ALT |  -  |  _  |  =   |  +  |  [  |   |  ]  |  {  |  }   |  \  | "|" | GUI |
//                   | SHFT | ENT |     |   |     | SPC | BKSP |
                        bindings = <
    &trans      &kp EXCL    &kp AT     &kp HASH  &kp DLLR  &kp PRCNT   &kp CARET   &kp AMPS    &kp STAR    &kp LPAR    &kp RPAR    &kp GRAVE
    &trans      &kp N1      &kp N2     &kp N3    &kp N4    &kp N5      &kp N6      &kp N7      &kp N8      &kp N9      &kp N0      &kp TILDE
    &trans      &kp MINUS   &kp UNDER  &kp EQUAL &kp PLUS  &kp LBKT    &kp RBKT    &kp LBRC    &kp RBRC    &kp BSLH    &kp PIPE    &trans
                                       &trans    &trans    &trans      &trans      &trans      &trans
                        >;
                };

                raise_layer {
// -----------------------------------------------------------------------------------------
// | TAB  |      |      |      |      |      |   | INS | HOME |  UP  | END | PGUP | ESC  |
// | RCTL | LOCK | SCSH | APP  | CAPS | NMLK |   | DEL | LEFT |  DN  | RGT | PGDN |      | 
// | RALT | BR-  | BR+  | VOL- | VOL+ | VOLx |   |     | PRV  | P/P  | NXT |      | RGUI |
//                      | SHFT | ENT  |      |   |     | SPC  | BKSP |
                        bindings = <
    &trans      &none         &none         &none         &none         &none          &kp INS   &kp HOME    &kp UP     &kp END     &kp PG_UP  &kp ESC
    &kp RCTRL   &kp C_AL_LOCK &kp PSCRN     &kp K_APP     &kp CAPS      &kp KP_NUM     &kp DEL   &kp LEFT    &kp DOWN   &kp RIGHT   &kp PG_DN  &none
    &kp RALT    &kp C_BRI_DN  &kp C_BRI_UP  &kp C_VOL_DN  &kp C_VOL_UP  &kp C_MUTE     &none     &kp C_PREV  &kp C_PP   &kp C_NEXT  &none      &kp RGUI
                                            &trans        &trans        &trans         &trans    &trans      &trans
                                                 >;
                };

                adjust_layer {
// -----------------------------------------------------------------------------------------
// | BOOT |     |     |     |     |       |   |     |     |     |     |     | BOOT |
// |      | F1  | F2  | F3  | F4  | F5    |   | F6  | F7  | F8  | F9  | F10 |      |
// |      | BT1 | BT2 | BT3 | BT4 | BTCLR |   |     | F11 | F12 |     |     |      |
//                    |     |     |       |   |     |     |     |
                        bindings = <
   &bootloader  &none        &none        &none        &none        &none         &none    &none    &none    &none    &none    &bootloader
   &none        &kp F1       &kp F2       &kp F3       &kp F4       &kp F5        &kp F6   &kp F7   &kp F8   &kp F9   &kp F10  &none
   &none        &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_CLR    &none    &kp F11  &kp F12  &none    &none    &none
                                          &none        &none        &trans        &trans   &none    &none
                        >;
                };
        };
};